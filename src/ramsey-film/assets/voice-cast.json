      "reference": {
        "file": "conversation-1.mp3",
        "startSeconds": 0,
        "endSeconds": 20,
        "transcript": "You invited me to a house named after someone else, gave me a chair, and arranged us like a diagram. Before we begin, I want to know something. Am I here because you wanted me, or because you needed a sixth person?",
        "sha256": "e1e83a7079a60a3d0b44506d78f1ea899b25c217444727698a69d051a48f580c"
      },
      "approval": "approved-first-five-minutes",
