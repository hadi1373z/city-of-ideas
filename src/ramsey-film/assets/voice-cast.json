      "provider": null,
      "model": null,
      "providerVoiceId": null,
      "generationSettings": null,
      "reference": {
        "file": "conversation-1.mp3",
        "startSeconds": 40,
        "endSeconds": 60,
        "transcript": "Then let us settle what your problem means before it settles anything about us. When you say two people know each other, do you mean they recognise a face, know a name, or understand a person? Those are rather different accomplishments.",
        "sha256": "e1e83a7079a60a3d0b44506d78f1ea899b25c217444727698a69d051a48f580c"
      },
      "approval": "approved-first-five-minutes",
      "status": "original-provider-unknown"
    },
    "socrates": {
      "voiceKey": "city.socrates.v1",
      "provider": null,
      "model": null,
      "providerVoiceId": null,
      "generationSettings": null,
      "reference": {
        "file": "conversation-2.mp3",
        "startSeconds": 30,
        "endSeconds": 40,
        "transcript": "Before the proof, what is an acquaintance? Is it enough to know a name, or must two people recognize one another?",
        "sha256": "ec6981de0aba944e2719242aaccbb8af53542d5ddc9077223b5765228fb1367e"
      },
      "approval": "unconfirmed-first-appearance",
      "status": "original-provider-unknown"
