      "providerVoiceId": null,
      "generationSettings": null,
      "reference": {
        "file": "conversation-1.mp3",
        "startSeconds": 20,
        "endSeconds": 40,
        "transcript": "Both, perhaps. Six is useful for a little problem. But a useful number is a poor reason to invite someone to dinner. Stay for the problem, if you like. Afterwards you can decide whether the company deserves any more of your evening.",
        "sha256": "e1e83a7079a60a3d0b44506d78f1ea899b25c217444727698a69d051a48f580c"
      },
      "approval": "approved-first-five-minutes",
      "status": "original-provider-unknown"
    },
    "turing": {
